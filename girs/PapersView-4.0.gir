    <function name="css_utils_filter_class_chars"
              c:identifier="pps_css_utils_filter_class_chars">
      <doc xml:space="preserve"
           filename="libview/pps-css-utils.c"
           line="201">Returns @str as a new string removing any character which
is not allowed in a css class name.

Css class names should only contain following characters:
  - a–z A–Z 0–9 - _
  - any Unicode character ≥ U+00A0</doc>
      <source-position filename="libview/pps-css-utils.h" line="21"/>
      <return-value transfer-ownership="full">
        <doc xml:space="preserve"
             filename="libview/pps-css-utils.c"
             line="212">newly allocated string</doc>
