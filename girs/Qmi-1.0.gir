    <function name="message_tlv_read_fixed_size_string"
              c:identifier="qmi_message_tlv_read_fixed_size_string"
              version="1.12"
              throws="1">
      <doc xml:space="preserve"
           filename="src/libqmi-glib/qmi-message.h"
           line="925">Reads a string from the TLV.

The string written in @out will need to be NUL-terminated by the caller.

@offset needs to point to a valid @gsize specifying the index to start
reading from within the TLV value (0 for the first item). If the variable
is successfully read, @offset will be updated to point past the read item.

Since 1.24.6 the read string is guaranteed to be valid UTF-8.

The fixed sized field may be suffixed with e.g. 0xFF if the contents are
shorter than @string_length. Since 1.26, this method will return the valid
UTF-8 characters in the start of the string, instead of returning an error
when doing the full UTF-8 string validation.</doc>
      <source-position filename="src/libqmi-glib/qmi-message.h" line="953"/>
      <return-value transfer-ownership="none">
        <doc xml:space="preserve"
             filename="src/libqmi-glib/qmi-message.h"
             line="949">%TRUE if the variable is successfully read, otherwise %FALSE is returned and @error is set.</doc>
        <type name="gboolean" c:type="gboolean"/>
      </return-value>
      <parameters>
        <parameter name="self" transfer-ownership="none">
          <doc xml:space="preserve"
               filename="src/libqmi-glib/qmi-message.h"
               line="927">a #QmiMessage.</doc>
          <type name="Message" c:type="QmiMessage*"/>
        </parameter>
        <parameter name="tlv_offset" transfer-ownership="none">
          <doc xml:space="preserve"
               filename="src/libqmi-glib/qmi-message.h"
               line="928">offset that was returned by qmi_message_tlv_read_init().</doc>
          <type name="gsize" c:type="gsize"/>
        </parameter>
        <parameter name="offset"
                   direction="inout"
                   caller-allocates="0"
                   transfer-ownership="full">
          <doc xml:space="preserve"
               filename="src/libqmi-glib/qmi-message.h"
               line="929">address of a the offset within the TLV value.</doc>
          <type name="gsize" c:type="gsize*"/>
        </parameter>
        <parameter name="string_length" transfer-ownership="none">
          <doc xml:space="preserve"
               filename="src/libqmi-glib/qmi-message.h"
               line="930">amount of bytes to read.</doc>
          <type name="guint16" c:type="guint16"/>
        </parameter>
        <parameter name="out"
                   direction="out"
                   caller-allocates="0"
                   transfer-ownership="full">
          <doc xml:space="preserve"
               filename="src/libqmi-glib/qmi-message.h"
               line="931">buffer preallocated by the client, with at least @string_length bytes.</doc>
          <type name="utf8" c:type="gchar*"/>
        </parameter>
      </parameters>
    </function>
