        <return-value transfer-ownership="none">
          <doc xml:space="preserve"
               filename="audio/ags_recall.c"
               line="9177">next matching #GList-struct, or %NULL if not found</doc>
          <type name="GLib.List" c:type="GList*">
            <type name="Recall"/>
          </type>
        </return-value>
        <parameters>
          <parameter name="recall" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="audio/ags_recall.c"
                 line="9170">the #GList-struct containing #AgsRecall</doc>
            <type name="GLib.List" c:type="GList*">
              <type name="Recall"/>
