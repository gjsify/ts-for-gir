          </parameter>
          <parameter name="provider" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="audio/ags_recall.c"
                 line="9171">the #GObject, either #AgsAudio, #AgsChannel, #AgsRecycling or #AgsAudioSignal</doc>
