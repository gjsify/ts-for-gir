<?xml version="1.0" encoding="UTF-8"?>
<!-- Meson replaces @APP_ID@ with the app id from the Flatpak manifest. -->
<component type="desktop-application">
  <id>@APP_ID@</id>

  <name>__PROJECT_NAME__</name>
  <summary>__PROJECT_NAME__</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <!-- TODO: Replace both paragraphs. `appstreamcli validate` does not catch
       these placeholders, so check them yourself. The first paragraph is what
       app stores show, so say in one sentence what the app does. -->
  <description>
    <p>TODO: Describe in one clear sentence what your application does.</p>
    <p>TODO: A second paragraph about who it is for and what it saves you.</p>
  </description>

  <launchable type="desktop-id">@APP_ID@.desktop</launchable>

  <categories>
    <category>Utility</category>
  </categories>

  <content_rating type="oars-1.1"/>

  <url type="homepage">https://example.com</url>
  <url type="bugtracker">https://example.com/issues</url>

  <developer id="com.example">
    <name>TODO: Your Name</name>
  </developer>

  <!-- Update `version` and `date` with every release. `appstreamcli validate`
       fails on a release without a date. -->
  <releases>
    <release version="0.1.0" date="2026-09-29"/>
  </releases>
</component>
