<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by Meson from data/app.metainfo.xml.in. The @APP_ID@ values are
     filled in at configure time from the Flatpak manifest's `-Dapp_id=`. -->
<component type="desktop-application">
  <id>@APP_ID@</id>

  <name>__PROJECT_NAME__</name>
  <summary>__PROJECT_NAME__</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <!-- TODO: replace both paragraphs. Neither is optional, and `appstreamcli
       validate` fails the Flatpak build on a placeholder: the first paragraph is
       required by AppStream and is what the store listing shows, so keep it to
       one clear sentence about what the app does. -->
  <description>
    <p>TODO: Describe in one clear sentence what your application does.</p>
    <p>TODO: A second paragraph about who it is for and what it saves you.</p>
  </description>

  <launchable type="desktop-id">@APP_ID@.desktop</launchable>

  <categories>
    <category>Utility</category>
  </categories>

  <content_rating type="oars-1.1"/>

  <url type="homepage">https://example.com</url>
  <url type="bugtracker">https://example.com/issues</url>

  <developer id="com.example">
    <name>TODO: Your Name</name>
  </developer>

  <!-- Bump `version` and `date` together on every release. `date` is not
       optional: `appstreamcli validate` fails without it, and Flathub rejects
       the build. -->
  <releases>
    <release version="0.1.0" date="2026-09-29"/>
  </releases>
</component>
