          <doc xml:space="preserve"
               filename="gfls/gfls-encoding-convert.c"
               line="497">source codeset.</doc>
          <type name="utf8" c:type="const gchar*"/>
        </parameter>
        <parameter name="allow_invalid_characters" transfer-ownership="none">
          <doc xml:space="preserve"
               filename="gfls/gfls-encoding-convert.c"
               line="498">whether invalid characters are allowed.</doc>
          <type name="gboolean" c:type="gboolean"/>
