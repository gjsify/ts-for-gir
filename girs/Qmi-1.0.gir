    <function name="message_add_raw_tlv"
              c:identifier="qmi_message_add_raw_tlv"
              version="1.0"
              throws="1">
      <doc xml:space="preserve"
           filename="src/libqmi-glib/qmi-message.h"
           line="1017">Creates a new @type TLV with the value given in @raw, and adds it to the #QmiMessage.</doc>
      <source-position filename="src/libqmi-glib/qmi-message.h" line="1031"/>
      <return-value transfer-ownership="none">
        <doc xml:space="preserve"
             filename="src/libqmi-glib/qmi-message.h"
             line="1027">%TRUE if the TLV is successfully added, otherwise %FALSE is returned and @error is set.</doc>
        <type name="gboolean" c:type="gboolean"/>
      </return-value>
      <parameters>
        <parameter name="self" transfer-ownership="none">
          <doc xml:space="preserve"
               filename="src/libqmi-glib/qmi-message.h"
               line="1019">a #QmiMessage.</doc>
          <type name="Message" c:type="QmiMessage*"/>
        </parameter>
        <parameter name="type" transfer-ownership="none">
          <doc xml:space="preserve"
               filename="src/libqmi-glib/qmi-message.h"
               line="1020">specific ID of the TLV to add.</doc>
          <type name="guint8" c:type="guint8"/>
        </parameter>
