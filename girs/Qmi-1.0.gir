    <function name="message_new_from_data"
              c:identifier="qmi_message_new_from_data"
              version="1.24"
              throws="1">
      <doc xml:space="preserve"
           filename="src/libqmi-glib/qmi-message.h"
           line="127">Create a new #QmiMessage for the given @service and @client_id and including the given QMI data buffer.

Whenever a complete QMI message is read, its data gets removed from the @qmi_data buffer.

This method should be used instead of qmi_message_new_from_raw() if the input data doesn't have QMUX headers.</doc>
      <source-position filename="src/libqmi-glib/qmi-message.h" line="144"/>
      <return-value transfer-ownership="full">
        <doc xml:space="preserve"
             filename="src/libqmi-glib/qmi-message.h"
             line="140">a newly created #QmiMessage, which should be freed with qmi_message_unref(). If @qmi_data doesn't contain a complete QMI data payload %NULL is returned. If there is a complete QMI data payload but it appears not to be valid, %NULL is returned and @error is set.</doc>
        <type name="Message" c:type="QmiMessage*"/>
      </return-value>
      <parameters>
        <parameter name="service" transfer-ownership="none">
          <doc xml:space="preserve"
               filename="src/libqmi-glib/qmi-message.h"
               line="129">a #QmiService</doc>
          <type name="Service" c:type="QmiService"/>
        </parameter>
        <parameter name="client_id" transfer-ownership="none">
          <doc xml:space="preserve"
               filename="src/libqmi-glib/qmi-message.h"
               line="130">client ID of the originating control point.</doc>
          <type name="guint8" c:type="guint8"/>
        </parameter>
        <parameter name="qmi_data"
                   direction="inout"
                   caller-allocates="0"
                   transfer-ownership="full">
          <doc xml:space="preserve"
               filename="src/libqmi-glib/qmi-message.h"
               line="131">data buffer containing only the QMI part of the message.</doc>
          <array name="GLib.ByteArray" c:type="GByteArray*">
            <type name="guint8" c:type="guint8"/>
          </array>
        </parameter>
      </parameters>
    </function>
