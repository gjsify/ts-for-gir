    <function name="char_buffer_util_copy_cbuffer_to_double"
              c:identifier="ags_char_buffer_util_copy_cbuffer_to_double"
              moved-to="CharBufferUtil.copy_cbuffer_to_double"
              version="3.0.0">
      <doc xml:space="preserve"
           filename="audio/ags_char_buffer_util.c"
