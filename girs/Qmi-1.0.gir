    <function name="message_tlv_read_string"
              c:identifier="qmi_message_tlv_read_string"
              version="1.12"
              throws="1">
      <doc xml:space="preserve"
           filename="src/libqmi-glib/qmi-message.h"
           line="892">Reads a string from the TLV.

@offset needs to point to a valid @gsize specifying the index to start
reading from within the TLV value (0 for the first item). If the variable
is successfully read, @offset will be updated to point past the read item.

Since 1.24.6 the read string is guaranteed to be valid UTF-8. Also, in order to
overcome known firmware errors on string fields, this method will also
attempt to parse the string as GSM-7 or UCS-2 if the initial UTF-8 validation
fails.</doc>
      <source-position filename="src/libqmi-glib/qmi-message.h" line="917"/>
      <return-value transfer-ownership="none">
        <doc xml:space="preserve"
             filename="src/libqmi-glib/qmi-message.h"
             line="913">%TRUE if the variable is successfully read, otherwise %FALSE is returned and @error is set.</doc>
        <type name="gboolean" c:type="gboolean"/>
      </return-value>
      <parameters>
        <parameter name="self" transfer-ownership="none">
          <doc xml:space="preserve"
               filename="src/libqmi-glib/qmi-message.h"
               line="894">a #QmiMessage.</doc>
          <type name="Message" c:type="QmiMessage*"/>
        </parameter>
        <parameter name="tlv_offset" transfer-ownership="none">
          <doc xml:space="preserve"
               filename="src/libqmi-glib/qmi-message.h"
               line="895">offset that was returned by qmi_message_tlv_read_init().</doc>
          <type name="gsize" c:type="gsize"/>
        </parameter>
        <parameter name="offset"
                   direction="inout"
                   caller-allocates="0"
                   transfer-ownership="full">
          <doc xml:space="preserve"
               filename="src/libqmi-glib/qmi-message.h"
               line="896">address of a the offset within the TLV value.</doc>
          <type name="gsize" c:type="gsize*"/>
        </parameter>
        <parameter name="n_size_prefix_bytes" transfer-ownership="none">
          <doc xml:space="preserve"
               filename="src/libqmi-glib/qmi-message.h"
               line="897">number of bytes used in the size prefix.</doc>
          <type name="guint8" c:type="guint8"/>
        </parameter>
        <parameter name="max_size" transfer-ownership="none">
          <doc xml:space="preserve"
               filename="src/libqmi-glib/qmi-message.h"
               line="898">maximum number of bytes to read, or 0 to read all available bytes.</doc>
          <type name="guint16" c:type="guint16"/>
        </parameter>
        <parameter name="out"
                   direction="out"
                   caller-allocates="0"
                   transfer-ownership="full">
          <doc xml:space="preserve"
               filename="src/libqmi-glib/qmi-message.h"
               line="899">return location for the read string. The returned value should be freed with g_free().</doc>
          <type name="utf8" c:type="gchar**"/>
        </parameter>
      </parameters>
    </function>
