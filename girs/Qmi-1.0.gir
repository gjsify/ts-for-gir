                 filename="src/libqmi-glib/qmi-device.h"
                 line="607">callback to build an abort request.</doc>
            <type name="DeviceCommandAbortableBuildRequestFn"
                  c:type="QmiDeviceCommandAbortableBuildRequestFn"/>
          </parameter>
          <parameter name="abort_parse_response_fn"
                     transfer-ownership="none"
                     scope="notified"
                     closure="5"
                     destroy="6">
            <doc xml:space="preserve"
                 filename="src/libqmi-glib/qmi-device.h"
                 line="608">callback to parse an abort response.</doc>
            <type name="DeviceCommandAbortableParseResponseFn"
                  c:type="QmiDeviceCommandAbortableParseResponseFn"/>
          </parameter>
          <parameter name="abort_user_data"
                     transfer-ownership="none"
                     nullable="1"
                     allow-none="1"
                     scope="notified">
            <doc xml:space="preserve"
                 filename="src/libqmi-glib/qmi-device.h"
                 line="609">user data to pass to @abort_build_request_fn and @abort_parse_response_fn.</doc>
            <type name="gpointer" c:type="gpointer"/>
          </parameter>
          <parameter name="abort_user_data_free"
